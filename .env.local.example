# Public client configuration only.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the JS bundle at build
# time and is readable from the packaged desktop app. Never put secrets here.
#
# Bright Data and other sensitive tokens are entered at runtime in Settings
# and stored in the OS keychain via Tauri Rust commands.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
